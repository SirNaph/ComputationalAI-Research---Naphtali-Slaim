# =============================================================================
# AI Independent Study 2026–2027 — .gitignore
# =============================================================================

# ---- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
.eggs/
build/
dist/
pip-wheel-metadata/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# ---- Virtual environments ---------------------------------------------------
.venv/
venv/
env/
ENV/
.python-version

# ---- Jupyter ----------------------------------------------------------------
.ipynb_checkpoints/
*/.ipynb_checkpoints/*
.jupyter/
.virtual_documents/

# ---- Secrets and credentials ------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
secrets/
credentials*.json
kaggle.json
wandb/

# ---- Datasets (download locally; never commit) -------------------------------
# Everything under a quarter's data/ folder is ignored EXCEPT split_indices/,
# which holds the small index files needed to reproduce train/val/test splits.
Q*/data/*
!Q*/data/split_indices/
!Q*/data/README.md
datasets/
*.gz
*-ubyte
*.idx*-ubyte
*.tar
*.tar.gz
*.zip
*.h5
*.hdf5
*.parquet
*.npz

# ---- Model checkpoints and weights ------------------------------------------
checkpoints/
*.ckpt
*.pt
*.pth
*.safetensors
*.onnx
lightning_logs/
runs/
mlruns/

# ---- macOS ------------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
Icon?

# ---- Editors / IDEs ---------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~

# ---- LaTeX build artifacts (manuscripts) ------------------------------------
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.synctex.gz
*.toc

# ---- Re-include split indices ------------------------------------------------
# Keep this block LAST so it overrides the dataset patterns above
# (e.g. *.npz) for the small files that define reproducible splits.
!Q*/data/split_indices/**
